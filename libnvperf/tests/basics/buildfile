import libs = libnvperf%lib{nvperf}
import host = libnvperf%libs{nvperf_grfx_host}

# Make sure the executables are importable.
#
import gpudiag           = libnvperf%exe{GpuDiag}
import metricsenumerator = libnvperf%exe{MetricsEnumerator}
import monitoring        = libnvperf%exe{Monitoring}

testscript{GpuDiag}@./:           test = $gpudiag
testscript{MetricsEnumerator}@./: test = $metricsenumerator
testscript{Monitoring}@./:        test = $monitoring

./: testscript{GpuDiag}@./           $gpudiag
./: testscript{MetricsEnumerator}@./ $metricsenumerator
./: testscript{Monitoring}@./        $monitoring

./: exe{driver}:    cxx{driver}    $libs
./: exe{grfx-host}: cxx{grfx-host} $host

# The upstream headers leave out trailing members in the parameter struct
# initializers, cast the functions they look up at runtime to the declared
# function types, and use Microsoft-specific enum values and warning
# pragmas, which GCC and Clang warn about with -Wall -Wextra -pedantic.
#
if ($cxx.id == 'gcc')
{
  cxx.coptions += -Wno-missing-field-initializers

  if ($cxx.target.class == 'windows')
    cxx.coptions += -Wno-unknown-pragmas
}
elif ($cxx.id == 'clang' || $cxx.id == 'msvc-clang')
  cxx.coptions += -Wno-missing-field-initializers -Wno-cast-function-type \
                  -Wno-deprecated-copy -Wno-microsoft-enum-value
