define [see_through] import: group

name = $string.replace($project, 'lib', '')

source redist.build

manifest_json = [json_object] $json.load($src_base/manifest.json)
package_ver   = "$(version.major).$(version.minor).$(version.patch)"

hdr_dirs = [dir_paths]
pub_hdrs = [strings]
for d: [json_array] ($manifest_json["includeDirs"])
{
  dir = [string] $d
  hdr_dirs += "$out_base/$dir/"
  pub_hdrs += "-I$out_base/$dir"
}

# The installed headers keep their layout below include/$project/ (see
# the end of this file), so let the generated pkg-config files search
# there, as the exported poptions do in the build tree.
#
cxx.pkgconfig.include = include/$project/

supported = false
for plat: [json_object] ($manifest_json["platforms"])
{
  plat_key = $member_name($plat)
  plat_val = $member_value($plat)
  enabled  = [bool] ($cc.target.cpu-$cc.target.class == $plat_key)
  archive{$name-$plat_key-$package_ver}: $src_base/manifest.json: include = $enabled
  extract{$name}: archive{$name-$plat_key-$package_ver}: include = $enabled

  # The archive ships every architecture. Only extract this architecture's
  # files and also export its include directory.
  #
  if $enabled
  {
    supported = true

    for d: [json_array] ($plat_val["includeDirs"])
    {
      dir = [string] $d
      sub = $leaf([dir_path] "$out_base/$dir/", [dir_path] "$out_base/NvPerf/include/")
      pub_hdrs += "-I$out_base/$dir"
      cxx.pkgconfig.include += "include/$project/$sub"
    }

    for x: [json_array] ($plat_val["exclude"])
    {
      pat = [string] $x
      extract_exclude += --exclude "$pat"
    }
  }
}

import{$name-headers}: extract{$name}: update = match
import{$name-legals}:  extract{$name}: update = match

import{$name-legals}:
{{
  o = $directory($>[0])
  d = $o/$name($>[0]).files

  legal = [paths] \
    "$out_base/redist/NVIDIA Nsight Perf SDK License \(28Sept2022).pdf" \
    "$out_base/redist/NvPerfUtility/LICENSE" \
    "$out_base/redist/NvPerfUtility/CREDITS.md"

  depdb dyndep \
    --dyn-target \
    --target-cwd "$o" \
    --target-what 'imported files' \
    --target-default-type 'legal' \
    --target-extension-type '=legal' \
    --format lines \
    --file $d \
    -- \
      echo $regex.merge($legal, '(.+)', '\1\n') >$d

  diag import $>

  for t : $filter_out($>, group)
  {
    touch $path($t)
  }
}}

import{$name-headers}:
{{
  o = $directory($>[0])
  d = $o/$name($>[0]).files

  find $hdr_dirs -type f -name "*" \
    | set -n f [paths]

  depdb dyndep \
    --dyn-target \
    --target-cwd "$o" \
    --target-what 'headers' \
    --target-default-type 'hxx' \
    --target-extension-type '=hxx' \
    --target-extension-type 'h=hxx' \
    --format lines \
    -- echo $regex.merge($f, '(.+)', '\1\n')

  diag import $>

  for f : $filter($>, hxx)
  {
    touch $path($f)
  }
}}

# Headers-only interface for loading the host library at runtime through
# nvperf_host_impl.h (upstream's NvPerf CMake target), which uses dlopen()
# on Linux.
#
./: lib{nvperf}:
{
  include = $supported
  clean   = false
}
[rule_hint=cxx] \
lib{nvperf}: import{$name-legals} import{$name-headers}: \
            extract{$name}:
{
  include = $supported
  update  = match
}

lib{nvperf}:
{
  cc.type            = cc
  cc.export.poptions = $pub_hdrs
}

if ($cc.target.class != 'windows')
{
  cc.libs += -ldl
  lib{nvperf}: cc.export.libs = -ldl
}

./: json{package}
json = [json_object] $json.load($src_base/package.json)
for plat: [json_object] ($json["platforms"])
{
  plat_key = $member_name($plat)
  enabled  = [bool] ($cc.target.cpu-$cc.target.class == $plat_key)
  plat_val = [json_object] $member_value($plat)

  for m: [json_object] ($plat_val["libs"])
  {
    n = $member_name($m)
    v = [json_object] ($member_value($m))

    ./: libs{$n}:
    {
      include = $enabled
      clean   = false
    }
    [rule_hint=cxx.link] \
    libs{$n}: import{$name-legals} import{$name-headers}: \
              extract{$name}:
    {
      include = $enabled
      update  = match
    }

    for b: [json_array] ($v["linked"])
    {
      dll  = [path] $out_base/($b["dll"])
      libi = [paths]
      for x: [json_array] ($b["libs"])
        libi += [paths] $out_base/$x

      <libs{$dll} libi{$libi}>: extract{$name}: include = $enabled
      libs{$n}: libs{$dll}: include = $enabled
      if $enabled
      {
        libs{$n}:
        {
          cc.export.libs =+ libs{$dll}
        }
      }
    }

    for s: [json_array] ($v["shared"])
    {
      so = [path] $out_base/$s
      <libs{$so}>: extract{$name}: include = $enabled
      libs{$n}: libs{$so}: include = $enabled
      if $enabled
      {
        if ($cc.target.class != 'windows')
        {
          libs{$n}:
          {
            cc.export.libs =+ libs{$so}
          }
        }
      }
    }

    for a: [json_array] ($v["archives"])
    {
      ar = [path] $out_base/$a
      <liba{$ar}>: extract{$name}: include = $enabled
      libs{$n}: liba{$ar}: include = $enabled
      if $enabled
      {
        libs{$n}: cc.export.libs += liba{$ar}
      }
    }

    for d2: [json_array] ($v["depends"])
    {
      dep = [name] $d2
      libs{$n}: libs{$dep}: include = $enabled
      if $enabled
      {
        libs{$n}: cc.export.libs += libs{$dep}
      }
    }

    libs{$n}:
    {
      cc.type            = cc
      cc.export.poptions = $pub_hdrs
    }
  }

  for m: [json_object] ($plat_val["exes"])
  {
    v = [json_object] ($member_value($m))
    p = [string] ($v["path"])

    # package.json leaves out the extension of the prebuilt executables so
    # that each one is a single target that its import resolves to. Since
    # no link rule assigns it, add it here.
    #
    if ($cc.target.class == 'windows')
      p = "$(p).exe"

    ./: exe{$p}: include = $enabled
    exe{$p}: import{$name-headers}: extract{$name}: include = $enabled

    exe{$p}:
    {
      install.subdirs = true
    }

    # The tools load the host library at runtime rather than linking it.
    #
    for d2: [json_array] ($v["depends"])
    {
      dep = [name] $d2
      exe{$p}: libs{$dep}:
      {
        include = ($enabled ? adhoc : false)
        clean = false
      }
    }
  }
}

# No registered rule matches a pre-built exe that has no source prerequisites
# and does not yet exist on disk. This ad-hoc regex pattern rule provides an
# explicit perform(update)/perform(clean) entry point for all path-qualified
# exe targets so build2 can attach the operation to them.
#
exe{~'/(.+)/'}:
{{
  diag import $> $<
  touch $path($>)
}}

exe{*}: install = bin/

# Install into the libnvperf/ subdirectory of, say, /usr/include/
# recreating subdirectories.
#
NvPerf/include/hxx{**}:
{
  install         = include/$project/
  install.subdirs = true
}

redist/NvPerfUtility/include/hxx{**}:
{
  install         = include/$project/
  install.subdirs = true
}
